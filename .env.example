# Copie para .env e preencha a senha antes de executar o Docker Compose.
# A URI abaixo usa o nome do serviço dentro do Compose.
MONGODB_URI=mongodb://mongo:27017/chamados_api
MONGODB_DATABASE=chamados_api
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_ADMIN_EMAIL=admin@local
APP_ADMIN_NOME=Administrador
SESSION_TIMEOUT=30m
